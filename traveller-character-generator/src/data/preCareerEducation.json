{
  "university": {
    "name": "University",
    "description": "Many worlds have one or more universities within their major settlements. A university education will channel a Traveller's efforts into a narrow range of skills.",
    "entry": {
      "attribute": "EDU",
      "target": 6,
      "modifiers": {
        "term_2": -1,
        "term_3": -2,
        "soc_9_plus": 1
      }
    },
    "skills": {
      "description": "Choose a level 0 and a level 1 skill from the following list",
      "available": [
        "Admin",
        "Advocate", 
        "Animals",
        "Art",
        "Astrogation",
        "Electronics",
        "Engineer",
        "Language",
        "Medic",
        "Navigation",
        "Profession",
        "Science"
      ],
      "automatic": {
        "EDU": 1
      }
    },
    "graduation": {
      "attribute": "INT",
      "target": 6,
      "honors_target": 10
    },
    "graduation_benefits": {
      "standard": {
        "skill_increases": "both_chosen_skills_plus_1",
        "edu_bonus": 1,
        "career_bonuses": {
          "Agent": 1,
          "Army": 1,
          "Citizen": 1,
          "Entertainer": 1,
          "Marines": 1,
          "Navy": 1,
          "Scholar": 1,
          "Scouts": 1
        },
        "commission_bonus": 1
      },
      "honors": {
        "skill_increases": "both_chosen_skills_plus_1",
        "edu_bonus": 1,
        "career_bonuses": {
          "Agent": 2,
          "Army": 2,
          "Citizen": 2,
          "Entertainer": 2,
          "Marines": 2,
          "Navy": 2,
          "Scholar": 2,
          "Scouts": 2
        },
        "commission_bonus": 2
      }
    }
  },
  "military_academy": {
    "name": "Military Academy",
    "description": "For those looking to dedicate their lives to military service, there is no better option than joining an academy.",
    "types": {
      "army": {
        "name": "Army Academy",
        "entry": {
          "attribute": "END",
          "target": 7,
          "modifiers": {
            "term_2": -2,
            "term_3": -4
          }
        },
        "service_skills": ["Gun Combat", "Drive", "Vacc Suit", "Athletics", "Mechanic", "Heavy Weapons"]
      },
      "marines": {
        "name": "Marine Academy", 
        "entry": {
          "attribute": "END",
          "target": 8,
          "modifiers": {
            "term_2": -2,
            "term_3": -4
          }
        },
        "service_skills": ["Athletics", "Vacc Suit", "Tactics", "Heavy Weapons", "Gun Combat", "Stealth"]
      },
      "navy": {
        "name": "Naval Academy",
        "entry": {
          "attribute": "INT", 
          "target": 8,
          "modifiers": {
            "term_2": -2,
            "term_3": -4
          }
        },
        "service_skills": ["Pilot", "Vacc Suit", "Athletics", "Gunner", "Mechanic", "Gun Combat"]
      }
    },
    "graduation": {
      "attribute": "INT",
      "target": 7,
      "honors_target": 11,
      "modifiers": {
        "end_8_plus": 1,
        "soc_8_plus": 1
      }
    },
    "graduation_benefits": {
      "standard": {
        "skill_selection": "choose_3_service_skills_to_level_1",
        "edu_bonus": 1,
        "automatic_entry": true,
        "commission_bonus": 2
      },
      "honors": {
        "skill_selection": "choose_3_service_skills_to_level_1", 
        "edu_bonus": 1,
        "soc_bonus": 1,
        "automatic_entry": true,
        "automatic_commission": true
      }
    }
  },
  "events": {
    "2": {
      "description": "You are approached by an underground (and highly illegal) psionic group who sense potential in you. You may test your PSI and attempt to enter the Psion career in any subsequent term.",
      "effects": {
        "psi_test_available": true
      }
    },
    "3": {
      "description": "Your time in education is not a happy one and you suffer a deep tragedy; perhaps you become hopelessly addicted to drink or drugs, a failed romance leaves you in tatters or a fatal accident involving a close friend shakes your confidence. You crash and fail to graduate.",
      "effects": {
        "graduation_failure": true
      }
    },
    "4": {
      "description": "A supposedly harmless prank goes wrong and someone gets hurt, physically or emotionally.",
      "effects": {
        "roll_required": {
          "attribute": "SOC",
          "target": 8,
          "success": {
            "rival": 1
          },
          "failure": {
            "enemy": 1
          },
          "critical_failure": {
            "graduation_failure": true,
            "forced_career": "Prisoner"
          }
        }
      }
    },
    "5": {
      "description": "Taking advantage of youth, you party as much as you study.",
      "effects": {
        "skills": {
          "Carouse": 1
        }
      }
    },
    "6": {
      "description": "You become involved in a tightly knit clique or group and make a pact to remain friends forever, wherever in the galaxy you may end.",
      "effects": {
        "allies": "1d3"
      }
    },
    "7": {
      "description": "Life Event. Roll on the Life Events table.",
      "effects": {
        "life_event": true
      }
    },
    "8": {
      "description": "You join a political movement.",
      "effects": {
        "roll_required": {
          "attribute": "SOC",
          "target": 8,
          "success": {
            "ally": 1,
            "enemy": 1,
            "description": "You become a leading figure. Gain one Ally within the movement but gain one Enemy in wider society."
          },
          "failure": {
            "description": "Your involvement remains minor."
          }
        }
      }
    },
    "9": {
      "description": "You develop a healthy interest in a hobby or other area of study.",
      "effects": {
        "skill_choice": {
          "level": 0,
          "exclude": ["Jack-of-all-Trades"]
        }
      }
    },
    "10": {
      "description": "A newly arrived tutor rubs you up the wrong way and you work hard to overturn their conclusions.",
      "effects": {
        "skill_roll_required": {
          "target": 9,
          "success": {
            "skill_increase": 1,
            "rival": 1,
            "description": "You provide a truly elegant proof that soon becomes accepted as the standard approach."
          },
          "failure": {
            "description": "Your efforts come to nothing."
          }
        }
      }
    },
    "11": {
      "description": "War comes and a wide-ranging draft is instigated.",
      "effects": {
        "choice_required": {
          "options": [
            {
              "description": "Flee and join the Drifter career",
              "effects": {
                "forced_career": "Drifter",
                "graduation_failure": true
              }
            },
            {
              "description": "Accept the draft",
              "effects": {
                "draft_roll": "1d6",
                "draft_table": {
                  "1-3": "Army",
                  "4-5": "Marines", 
                  "6": "Navy"
                },
                "graduation_failure": true
              }
            },
            {
              "description": "Try to avoid the draft (SOC 9+ required)",
              "effects": {
                "roll_required": {
                  "attribute": "SOC",
                  "target": 9,
                  "success": {
                    "description": "You get enough strings pulled to avoid the draft and complete your education."
                  },
                  "failure": {
                    "draft_roll": "1d6",
                    "draft_table": {
                      "1-3": "Army",
                      "4-5": "Marines",
                      "6": "Navy"
                    },
                    "graduation_failure": true
                  }
                }
              }
            }
          ]
        }
      }
    },
    "12": {
      "description": "You gain wide-ranging recognition of your initiative and innovative approach to study.",
      "effects": {
        "attributes": {
          "SOC": 1
        }
      }
    }
  }
}